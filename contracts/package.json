{
  "name": "trekkey-credential-registry-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Kaia credential anchoring contracts for Trekkey",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "fixture:merkle": "hardhat run scripts/generate-merkle-fixture.ts",
    "deploy:kairos": "hardhat run scripts/deploy-kairos.ts --network kairos",
    "configure:kairos": "hardhat run scripts/configure-kairos.ts --network kairos",
    "sign:approval": "hardhat run scripts/sign-approval.ts",
    "verify:kairos": "hardhat verify --network kairos"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@types/node": "22.13.0",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/merkle-tree": "1.0.8",
    "dotenv": "16.4.7",
    "hardhat": "2.29.0",
    "typescript": "5.7.3"
  }
}
