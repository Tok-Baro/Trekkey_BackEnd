# Kairos public RPC. Override when using a managed or institutional RPC endpoint.
KAIROS_RPC_URL=https://public-en-kairos.node.kaia.io

# Kairos AccountKeyLegacy deployment account. Never commit an actual private key.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Required only for Kaiascan source-code verification.
KAIASCAN_API_KEY=

# Post-deployment Kairos configuration.
REGISTRY_ADDRESS=
ISSUER_PUBLIC_ID=
# Start at 1 for a new issuer. The committed Kairos manifest currently uses version 2.
ISSUER_KEY_VERSION=1
# EIP-712 recovered EVM address; it need not hold KAIA.
ISSUER_SIGNER_ADDRESS=
# Optional one-time public proof for a signer held outside Kaia Wallet.
ISSUER_PROOF_SIGNATURE=
# AccountKeyLegacy EOA used by the standard web3j relayer.
RELAYER_ADDRESS=
# Public UI setting: bootstrap tops the relayer up only to this balance. Maximum is 5 KAIA.
RELAYER_TARGET_BALANCE_KAIA=1

# Local development signing helper only. Use an external KMS/HSM or wallet in production.
ISSUER_PRIVATE_KEY=
TYPED_DATA_FILE=
