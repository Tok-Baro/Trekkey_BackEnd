#[test]
fun sui_approval_golden_fixture() {
    let domain = crypto::domain_separator(x"a1b2c3d4", @0x1111111111111111111111111111111111111111111111111111111111111111, @0x2222222222222222222222222222222222222222222222222222222222222222);
    assert!(domain == x"f55bbc834fe667f3186f352a92079aeff2618696fee9e3259f7d9482a5ac6d70", 0);
    let batch = crypto::batch_struct_hash(x"3333333333333333333333333333333333333333333333333333333333333333", x"4444444444444444444444444444444444444444444444444444444444444444", x"5555555555555555555555555555555555555555555555555555555555555555",
        x"6666666666666666666666666666666666666666666666666666666666666666", 3, 1, 2, 7, 2000000000);
    assert!(batch == x"b444c74a75e99e318f2e98b9915554ac575af28acf2014babf9500d7ceaa3970", 1);
    let message = crypto::approval_message(domain, batch);
    assert!(message == x"1901f55bbc834fe667f3186f352a92079aeff2618696fee9e3259f7d9482a5ac6d70b444c74a75e99e318f2e98b9915554ac575af28acf2014babf9500d7ceaa3970", 2);
    assert!(hash::keccak256(&message) == x"cdfa224dd54a421545b2c4f4c13508d21f9523181f58ce7334506c2278602c7e", 3);
    assert!(crypto::recover_ethereum_signer(&message, x"18bb0a323e42d5be76343fbd190019007d7f0907980e6f3dd01092154b5dcbc50278399d5a5300615501b2ea8e505e118f49844a8eb746e1e197acfdef3943f91b") == x"7e5f4552091a69125d5dfcb7b8c2659029395bdf", 4);
    let status = crypto::status_struct_hash(x"3333333333333333333333333333333333333333333333333333333333333333", x"7777777777777777777777777777777777777777777777777777777777777777", 1,
        x"8888888888888888888888888888888888888888888888888888888888888888", 1800000000, 2, 8, 2000000000);
    assert!(status == x"399cc521f1ba92af779b2f2be4b2ccbdf643b455d63d45e414e1c5980f241167", 5);
    let message = crypto::approval_message(domain, status);
    assert!(message == x"1901f55bbc834fe667f3186f352a92079aeff2618696fee9e3259f7d9482a5ac6d70399cc521f1ba92af779b2f2be4b2ccbdf643b455d63d45e414e1c5980f241167", 6);
    assert!(hash::keccak256(&message) == x"73720dcece4ae50505fc8b7628d662b4717c841dcc99915dd9988e1d1025dce5", 7);
    assert!(crypto::recover_ethereum_signer(&message, x"e173c2943a3c6049cf69fa96e86eecba92776b5006dfb47f3722353c87068818665f35416c3a85144e6c9e4e7e4eed682a44038c3526998231b12c318c5cd32e1c") == x"7e5f4552091a69125d5dfcb7b8c2659029395bdf", 8);
}
